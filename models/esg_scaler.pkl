import pandas as pd
from sklearn.preprocessing import StandardScaler
import joblib

# =====================================================
# LOAD DATA (same features used in ESG model training)
# =====================================================

df = pd.read_csv("data/esg_dataset.csv")

# Example feature columns (must match your model input)
features = [
    "Carbon_Emission",
    "Renewable_Energy_Usage",
    "Waste_Recycled",
    "Employee_Satisfaction",
    "Gender_Diversity",
    "Board_Independence"
]

X = df[features]

# =====================================================
# FIT SCALER
# =====================================================

scaler = StandardScaler()
scaler.fit(X)

# =====================================================
# SAVE SCALER
# =====================================================

joblib.dump(scaler, "models/esg_scaler.pkl")

print("✅ ESG Scaler saved successfully as models/esg_scaler.pkl")
